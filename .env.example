# Copy to .env.local and fill in. Never commit real values.

# Server only. Request a key at https://events.vex.com/api/v2/accessRequest/create
VEX_API_KEY=your-vex-events-api-key

# Server only. YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=your-youtube-data-api-key

# Public. From your Supabase project settings (anon key is safe to expose; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Accounts stay hidden until the Supabase setup steps are done. Set to true after running
# supabase/migrations and configuring sign-in emails.
ACCOUNTS_ENABLED=false

# Public. The address sign-in emails link back to, for example http://localhost:3009 locally.
NEXT_PUBLIC_SITE_URL=your-site-url
